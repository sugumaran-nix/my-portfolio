---
interface Props {
  class?: string;
  className?: string;
  delay?: number;
}

const { class: classProp = '', className = '', delay = 0 } = Astro.props;
const wrapperClass = classProp || className;
---

<div
  class={`magic-card-wrap reveal relative overflow-hidden ${wrapperClass}`}
  style={`transition-delay: ${delay}s`}
>
  <div class="magic-card-spotlight pointer-events-none absolute inset-0 z-0 opacity-0 transition-opacity duration-200"></div>
  <div class="relative z-10 h-full">
    <slot />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.magic-card-wrap').forEach((card) => {
    card.addEventListener('mousemove', (event) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${event.clientX - rect.left}px`);
      card.style.setProperty('--mouse-y', `${event.clientY - rect.top}px`);
    });
  });
</script>
