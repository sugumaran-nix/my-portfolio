---
const categories = [
  {
    title: 'Languages',
    icon: '<path d="M4 5h16M4 12h16M4 19h16M8 2l-4 10 4 10M16 2l4 10-4 10" stroke-linecap="round" stroke-linejoin="round" />',
    span: 'sm:col-span-2 md:col-span-2',
    skills: ['Python (Primary)', 'TypeScript', 'JavaScript (ES6+)', 'SQL'],
  },
  {
    title: 'Frontend',
    icon: '<rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M7 14h3M7 17h6" stroke-linecap="round" />',
    span: 'sm:col-span-1 md:col-span-1',
    skills: ['React.js', 'Next.js', 'Tailwind CSS'],
  },
  {
    title: 'Backend',
    icon: '<rect x="4" y="4" width="16" height="6" rx="1" /><rect x="4" y="14" width="16" height="6" rx="1" /><path d="M8 7h.01M8 17h.01M12 7h5M12 17h5" stroke-linecap="round" />',
    span: 'sm:col-span-1 md:col-span-1',
    skills: ['FastAPI', 'Flask', 'WebSockets'],
  },
  {
    title: 'Databases',
    icon: '<ellipse cx="12" cy="5" rx="7" ry="3" /><path d="M5 5v7c0 1.66 3.13 3 7 3s7-1.34 7-3V5M5 12v7c0 1.66 3.13 3 7 3s7-1.34 7-3v-7" />',
    span: 'sm:col-span-1 md:col-span-1',
    skills: ['MySQL', 'MongoDB'],
  },
  {
    title: 'Tools & OS',
    icon: '<path d="M14.7 6.3a4 4 0 00-5.2 5.2L4 17a2.12 2.12 0 003 3l5.5-5.5a4 4 0 005.2-5.2l-2.3 2.3-2.8-.2-.2-2.8 2.3-2.3z" stroke-linecap="round" stroke-linejoin="round" />',
    span: 'sm:col-span-1 md:col-span-1',
    skills: ['Git', 'Docker', 'Linux'],
  },
  {
    title: 'AI / ML & NLP',
    icon: '<path d="M12 3a3 3 0 013 3v1h1a3 3 0 013 3v1a3 3 0 013 3 3 3 0 01-3 3h-1v1a3 3 0 01-3 3 3 3 0 01-3-3v-1H9a3 3 0 01-3-3v-1a3 3 0 013-3h1V6a3 3 0 013-3z" stroke-linecap="round" stroke-linejoin="round" /><path d="M9 12h6M12 9v6" stroke-linecap="round" />',
    span: 'sm:col-span-2 md:col-span-3',
    skills: ['Scikit-learn', 'Hugging Face', 'BERT', 'Prompt Engineering', 'NLP'],
    featured: true,
  },
];
---

<div class="skills-grid mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
  {categories.map((category, index) => (
    <div
      class={`card-surface reveal flex cursor-default flex-col gap-3.5 p-5 sm:p-6 ${category.span}`}
      style={`transition-delay: ${index * 0.07}s`}
    >
      <div class="flex items-center gap-2.5">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class={`${category.featured ? 'h-5 w-5' : 'h-[18px] w-[18px]'} flex-shrink-0 text-ink dark:text-white`} set:html={category.icon} />
        <h3 class={`font-semibold text-ink dark:text-white ${category.featured ? 'text-[15px]' : 'text-[14px]'}`}>
          {category.title}
        </h3>
      </div>
      <div class="flex flex-wrap gap-2">
        {category.skills.map((skill) => (
          <span class="card-chip">
            {skill}
          </span>
        ))}
      </div>
    </div>
  ))}
</div>
