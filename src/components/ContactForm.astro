---
const serviceId = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID || 'service_id';
const templateId = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID || 'template_id';
const publicKey = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY || 'public_key';

const inputBase = 'control-input';
---

<form
  id="contact-form"
  class="flex flex-col gap-4"
  data-service-id={serviceId}
  data-template-id={templateId}
  data-public-key={publicKey}
  noValidate
>
  <div class="flex flex-col gap-1.5">
    <label for="cf-name" class="text-xs font-semibold uppercase tracking-wider text-inkMuted dark:text-white/60">Name</label>
    <input id="cf-name" name="name" type="text" autoComplete="name" placeholder="Your name" maxlength="80" class={inputBase} />
    <p id="cf-name-error" class="hidden text-xs font-medium italic text-ink/70 dark:text-white/65"></p>
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="cf-email" class="text-xs font-semibold uppercase tracking-wider text-inkMuted dark:text-white/60">Email</label>
    <input id="cf-email" name="email" type="email" autoComplete="email" placeholder="your@email.com" maxlength="120" class={inputBase} />
    <p id="cf-email-error" class="hidden text-xs font-medium italic text-ink/70 dark:text-white/65"></p>
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="cf-message" class="text-xs font-semibold uppercase tracking-wider text-inkMuted dark:text-white/60">Message</label>
    <textarea id="cf-message" name="message" rows="5" placeholder="Your message..." maxlength="2000" class={`${inputBase} resize-none`}></textarea>
    <p id="cf-message-error" class="hidden text-xs font-medium italic text-ink/70 dark:text-white/65"></p>
  </div>

  <p id="cf-submit-error" class="hidden text-xs font-medium italic text-ink/70 dark:text-white/65"></p>

  <button id="cf-submit" type="submit" class="btn-filled-pill mt-1 w-full">
    <span class="cf-submit-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
    <span class="cf-submit-spinner hidden" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 animate-spin"><path d="M12 3a9 9 0 109 9" stroke-linecap="round" /></svg>
    </span>
    <span class="cf-submit-label">Send Message</span>
  </button>
</form>

<div id="contact-form-success" class="hidden flex-col items-center justify-center gap-3 py-14 text-center">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-10 w-10 text-ink dark:text-white/80"><path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round" stroke-linejoin="round" /><path d="M22 4L12 14.01l-3-3" stroke-linecap="round" stroke-linejoin="round" /></svg>
  <p class="text-base font-semibold">Message sent!</p>
  <p class="text-sm text-inkMuted dark:text-white/50">I'll get back to you within a few hours.</p>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('contact-form-success');
  const submit = document.getElementById('cf-submit') as HTMLButtonElement | null;
  if (!form || !submit) throw new Error('Contact form failed to initialize');

  const getInput = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
  const errorFor = (name: string) => document.getElementById(`cf-${name}-error`);
  const submitError = document.getElementById('cf-submit-error');
  const submitLabel = submit.querySelector('.cf-submit-label');
  const submitIcon = submit.querySelector('.cf-submit-icon');
  const submitSpinner = submit.querySelector('.cf-submit-spinner');

  const showError = (name: string, message = '') => {
    const element = errorFor(name);
    if (!element) return;
    element.textContent = message;
    element.classList.toggle('hidden', !message);
  };

  const validate = () => {
    const name = getInput('name').value;
    const email = getInput('email').value;
    const message = getInput('message').value;
    const errors: Record<string, string> = {};
    if (!name.trim() || name.trim().length < 2) errors.name = 'Name must be at least 2 characters';
    if (!/^[a-zA-Z0-9._%+\-]{2,}@[a-zA-Z0-9.\-]+\.[a-zA-Z]{2,}$/.test(email)) errors.email = 'Enter a valid email address';
    if (!message.trim() || message.trim().length < 10) errors.message = 'Message must be at least 10 characters';
    Object.keys(errors).forEach((key) => showError(key, errors[key]));
    return errors;
  };

  ['name', 'email', 'message'].forEach((name) => {
    getInput(name).addEventListener('input', () => showError(name));
  });

  const loadEmailJs = () => new Promise<any>((resolve, reject) => {
    const existing = (window as unknown as { emailjs?: any }).emailjs;
    if (existing) return resolve(existing);
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
    script.async = true;
    script.onload = () => {
      const emailjs = (window as unknown as { emailjs?: any }).emailjs;
      emailjs ? resolve(emailjs) : reject(new Error('emailjs-unavailable'));
    };
    script.onerror = () => reject(new Error('emailjs-unavailable'));
    document.head.appendChild(script);
    window.setTimeout(() => reject(new Error('emailjs-timeout')), 5000);
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    submitError?.classList.add('hidden');
    const errors = validate();
    if (Object.keys(errors).length) return;

    submit.disabled = true;
    submitLabel && (submitLabel.textContent = 'Sending…');
    submitIcon?.classList.add('hidden');
    submitSpinner?.classList.remove('hidden');

    try {
      const emailjs = await loadEmailJs();
      const timeout = new Promise((_, reject) => window.setTimeout(() => reject(new Error('timeout')), 10000));
      await Promise.race([
        emailjs.send(form.dataset.serviceId, form.dataset.templateId, {
          from_name: getInput('name').value,
          from_email: getInput('email').value,
          message: getInput('message').value,
        }, form.dataset.publicKey),
        timeout,
      ]);
      form.classList.add('hidden');
      success?.classList.replace('hidden', 'flex');
      window.dispatchEvent(new CustomEvent('form-sent'));
    } catch (error) {
      submitError && (submitError.textContent = error instanceof Error && error.message === 'timeout'
        ? 'Request timed out. Try emailing me directly at sugumarankugan@gmail.com'
        : 'Something went wrong. Email me directly at sugumarankugan@gmail.com');
      submitError?.classList.remove('hidden');
      submit.disabled = false;
      submitLabel && (submitLabel.textContent = 'Send Message');
      submitIcon?.classList.remove('hidden');
      submitSpinner?.classList.add('hidden');
    }
  });
</script>
