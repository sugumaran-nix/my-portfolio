---
const socials = [
  { label: 'GitHub',   href: 'https://github.com/sugumaran-nix' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/sugumaran-nix' },
  { label: 'Email',    href: 'mailto:sugumarankugan@gmail.com' },
];
---

<footer class="border-t border-borderLight dark:border-borderDark px-6 md:px-10 py-12">
  <div class="max-w-content mx-auto footer-inner">
    <!-- Display font name — DM Serif Display italic -->
    <p class="font-display italic text-2xl text-ink dark:text-white tracking-tight">Sugumaran.</p>

    <p class="text-sm text-inkMuted dark:text-white/30 max-w-xs leading-relaxed">
      Building things that actually work — AI/ML, full-stack, and everything in between.
    </p>

    <div class="flex items-center gap-5 mt-1">
      {socials.map((s, i) => (
        <>
          <a
            href={s.href}
            target={s.href.startsWith('http') ? '_blank' : undefined}
            rel={s.href.startsWith('http') ? 'noopener' : undefined}
            class="line-hover text-xs font-medium text-inkMuted/60 dark:text-white/30 hover:text-ink dark:hover:text-white transition-colors"
          >
            {s.label}
          </a>
          {i < socials.length - 1 && (
            <span class="text-inkMuted/25 dark:text-white/15 text-xs">·</span>
          )}
        </>
      ))}
    </div>

    <p class="text-xs text-inkMuted/30 dark:text-white/18 mt-4">
      © {new Date().getFullYear()} Sugumaran S. · Deployed, not just designed.
    </p>
  </div>
</footer>
