---
import MagicCard from './MagicCard.astro';

interface Props {
  title: string;
  desc: string;
  tags: string[];
  href: string;
  demoHref?: string;
  imgLight: string;
  imgDark: string;
  delay?: number;
  outcome?: string;
}

const { title, desc, tags, href, demoHref, imgLight, imgDark, delay = 0, outcome } = Astro.props;
const imgLightSmall = imgLight.replace('.webp', '-640.webp');
const imgDarkSmall = imgDark.replace('.webp', '-640.webp');
---

<MagicCard class="project-card card-surface flex h-full flex-col" delay={delay}>
  <div class="project-image-shell w-full aspect-[16/8] flex-shrink-0 relative overflow-hidden group img-skeleton">
    <img
      data-src={imgLight}
      data-srcset={`${imgLightSmall} 640w, ${imgLight} 1280w`}
      sizes="(max-width: 640px) calc(100vw - 48px), 560px"
      width="1280"
      height="607"
      alt={`${title} screenshot`}
      loading="lazy"
      decoding="async"
      class="project-img-light absolute inset-0 w-full h-full object-cover opacity-100 transition-opacity duration-200"
    />
    <img
      data-src={imgDark}
      data-srcset={`${imgDarkSmall} 640w, ${imgDark} 1280w`}
      sizes="(max-width: 640px) calc(100vw - 48px), 560px"
      width="1280"
      height="607"
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      class="project-img-dark absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-200"
    />
    <div class="project-image-fallback absolute inset-0 hidden items-center justify-center bg-gradient-to-br from-stone-700 to-stone-900">
      <span class="text-xs font-mono text-white/30">screenshot coming soon</span>
    </div>
    <a href={demoHref || href} target="_blank" rel="noopener noreferrer" class="project-img-overlay">
      View project
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
        <path d="M7 17L17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>

  <div class="flex flex-1 flex-col gap-3 px-2 pb-2 pt-4 sm:px-2 sm:pb-2 sm:pt-5">
    <h3 class="text-[15px] font-semibold leading-snug text-ink dark:text-white">{title}</h3>
    <p class="line-clamp-3 text-[14px] leading-[1.75] text-inkMuted dark:text-white/55">{desc}</p>
    {outcome && <p class="project-outcome">{outcome}</p>}

    <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
      {tags.map((tag) => (
        <span class="card-chip">
          {tag}
        </span>
      ))}
    </div>

    <div class="flex flex-wrap items-center gap-2 pt-1">
      {demoHref && (
        <a href={demoHref} target="_blank" rel="noopener noreferrer" class="btn-ghost-pill project-action">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3 w-3">
            <path d="M7 17L17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          View Live
        </a>
      )}
      {href && (
        <a href={href} target="_blank" rel="noopener noreferrer" class="btn-ghost-pill project-action project-action-icon" aria-label={`Open ${title} GitHub repository`} title="GitHub repository">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-4 w-4">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.1.82-.26.82-.58v-2.03c-3.34.72-4.04-1.61-4.04-1.61-.54-1.38-1.33-1.75-1.33-1.75-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 013-.4c1.02 0 2.04.13 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.69.82.57C20.56 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
          </svg>
        </a>
      )}
    </div>
  </div>
</MagicCard>

<script>
  const projectShells = Array.from(document.querySelectorAll<HTMLElement>('.project-image-shell'));

  const syncProjectImages = () => {
    const dark = document.documentElement.classList.contains('dark');
    projectShells.forEach((shell) => {
      const light = shell.querySelector<HTMLImageElement>('.project-img-light');
      const darkImage = shell.querySelector<HTMLImageElement>('.project-img-dark');
      const active = dark ? darkImage : light;
      const inactive = dark ? light : darkImage;
      if (active) {
        if (!active.getAttribute('src')) active.setAttribute('src', active.dataset.src ?? '');
        if (!active.getAttribute('srcset')) active.setAttribute('srcset', active.dataset.srcset ?? '');
      }
      inactive?.removeAttribute('src');
      inactive?.removeAttribute('srcset');
      light?.classList.toggle('opacity-0', dark);
      light?.classList.toggle('opacity-100', !dark);
      darkImage?.classList.toggle('opacity-0', !dark);
      darkImage?.classList.toggle('opacity-100', dark);
    });
  };

  projectShells.forEach((shell) => {
    const fallback = shell.querySelector<HTMLElement>('.project-image-fallback');
    const images = Array.from(shell.querySelectorAll<HTMLImageElement>('img'));
    images.forEach((image) => {
      image.addEventListener('load', () => shell.classList.remove('img-skeleton'), { once: true });
      image.addEventListener('error', () => {
        image.classList.add('hidden');
        shell.classList.remove('img-skeleton');
        fallback?.classList.replace('hidden', 'flex');
      }, { once: true });
    });
  });

  syncProjectImages();
  new MutationObserver(syncProjectImages).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class'],
  });
</script>
